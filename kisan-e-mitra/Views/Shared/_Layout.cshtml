<!DOCTYPE html>
<html class="notranslate" translate="no">
<head>
    <meta name="google" content="notranslate">
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title id="pageTitle">@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/pre-init-js")
    <script type="text/javascript" src="~/Content/js/fingerprint.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RCEZR4J24G"></script>
    <script type="text/javascript" src="~/Content/js/gtag.js"></script>
</head>
<body class="">
    @{
        var languageModel = TempData["LanguageModel"] as KisanEMitra.Models.LanguageModel;
        var availableLanguages = languageModel.AvailableLanguages;
        var selectedLanguage = languageModel.SelectedLanguage; 

        TempData.Keep("LanguageModel");
    }
    <div class="container-fluid chatbot-container">
        <div class="overlay"></div>
        <div class="kisan-e-mitra-content-text">
            <div class="d-flex justify-content-between align-items-center kisan-e-mitra-texts-padding" id="appHeader">
                <div class="logo-flex responsive-logo"><span class="d-flex justify-content-start p-2"><img src="~/Content/images/kisan-e-mitra-logo.png" class="kisan-e-mitra-logo"></span></div>
                <div class="content-head-text"><h1 class="labelTitle">@Resources.Resource.label_title</h1></div>
                <div class="d-flex justify-content-end">

                    <span id="startAppTourButton">
                        <img class="refresh-btn-style help-button" src="~/Content/images/help.png" />
                    </span>
                </div>
            </div>
            @RenderBody()
        </div>

    </div>
    <div class="footer">
        <p>Powered by Sunbird UCI | BHASHINI</p>
    </div>
    
    @Scripts.Render("~/bundles/post-init-js")
</body>
</html>
